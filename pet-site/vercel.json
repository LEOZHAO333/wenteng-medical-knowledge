{
  "version": 2,
  "redirects": [
    {
      "source": "/pet",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pet/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pet/:path((?!assets/).*)",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/pet?path="
    },
    {
      "source": "/:path((?!pet/|api/|assets/|llms\\.txt$|llms-full\\.txt$|baidu_verify_codeva-oEF0P4n4lu\\.html$).*)",
      "destination": "/api/pet?path=:path"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
