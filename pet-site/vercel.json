{
  "version": 2,
  "redirects": [
    {
      "source": "/pet",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pet/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pet/:path((?!assets/).*)",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/pet?path="
    },
    {
      "source": "/:path((?!pet/|api/|assets/).*)",
      "destination": "/api/pet?path=:path"
    }
  ]
}
